# File này quyết định thứ KHÔNG được copy vào image.
# Bỏ sót .env = leak secret vào image. Bỏ sót .git = image phình to.
# Lưu ý: app/, utils/ và requirements.txt là thứ image CẦN — không ignore.

# Secret
.env
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
*.egg-info/

# Git & CI
.git
.gitignore
.github/

# Thứ chỉ dùng lúc phát triển, image chạy production không cần
tests/
screenshots/
nginx/
solution/
*.md
docker-compose.yml
Dockerfile
.dockerignore

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
